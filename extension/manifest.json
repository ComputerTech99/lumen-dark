{
  "manifest_version": 3,
  "name": "Lumen Dark",
  "version": "1.4.4",
  "description": "Unofficial dark mode for BITS Pilani Digital's Lumen LMS. Readable lessons, untouched images, no data collected.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Lumen Dark",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "commands": {
    "toggle-dark": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Toggle dark mode"
    }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://lumen.bitspilani-digital.edu.in/*"],
      "css": ["dark.css"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
